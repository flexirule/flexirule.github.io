---
import BaseLayout from "../layouts/BaseLayout.astro";
import ComparisonCard from "../components/ComparisonCard.astro";
import { comparisons } from "../data/comparisons";

const description =
  "FlexiRule is a visual business automation and orchestration platform for Frappe and ERPNext. Model rules, branching, reusable processes, and execution tracing in one place.";
---

<BaseLayout title="Visual business automation for Frappe and ERPNext" description={description}>
  <section class="hero-section">
    <div class="container hero-grid">
      <div class="hero-copy">
        <a class="eyebrow-pill" href="https://github.com/Sendipad/flexirule">
          <span class="status-dot"></span>
          Built for Frappe Framework &amp; ERPNext
          <span aria-hidden="true">↗</span>
        </a>
        <h1>Make business logic <span class="text-gradient">visible.</span></h1>
        <p class="hero-lede">
          Design and orchestrate business workflows visually. Keep conditions, actions, branching,
          reusable processes, and execution traces connected in one understandable model.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="https://github.com/Sendipad/flexirule#installation">Get started <span aria-hidden="true">↗</span></a>
          <a class="button button-secondary" href="#how-it-works">Explore how it works <span aria-hidden="true">↓</span></a>
        </div>
        <div class="hero-proof">
          <span class="proof-mark" aria-hidden="true">✓</span>
          <span>Declarative workflows</span><span class="proof-separator">·</span>
          <span>Reusable logic</span><span class="proof-separator">·</span>
          <span>Execution visibility</span>
        </div>
      </div>

      <div class="builder-scene" role="img" aria-label="Illustration of a visual FlexiRule workflow builder showing an invoice approval rule, condition branches, and actions">
        <div class="scene-glow"></div>
        <div class="builder-window">
          <div class="builder-topbar">
            <div class="window-dots"><i></i><i></i><i></i></div>
            <div class="builder-title"><span class="mini-mark">R</span> Invoice approval <span class="saved-pill">Saved</span></div>
            <span class="builder-menu" aria-hidden="true">•••</span>
          </div>
          <div class="builder-content">
            <aside class="builder-sidebar">
              <span class="sidebar-cap">WORKFLOW</span>
              <div class="side-row active"><span class="side-icon">◇</span> Rule Builder</div>
              <div class="side-row"><span class="side-icon">⌘</span> Conditions</div>
              <div class="side-row"><span class="side-icon">▤</span> Actions</div>
              <div class="side-row"><span class="side-icon">◷</span> Execution log</div>
              <div class="sidebar-bottom"><span class="avatar-dot">FR</span><span>Rule details<br /><small>Draft</small></span></div>
            </aside>
            <div class="flow-canvas">
              <div class="canvas-label">EXECUTION FLOW <span>• LIVE PREVIEW</span></div>
              <div class="flow-lines" aria-hidden="true">
                <span class="line line-a"></span><span class="line line-b"></span><span class="line line-c"></span>
                <span class="line line-d"></span><span class="line line-e"></span>
              </div>
              <div class="flow-node node-trigger">
                <span class="node-symbol symbol-trigger">↗</span>
                <span class="node-copy"><small>TRIGGER</small><b>Invoice submitted</b></span><span class="node-status"></span>
              </div>
              <div class="flow-node node-condition">
                <span class="node-symbol symbol-condition">◇</span>
                <span class="node-copy"><small>CONDITION</small><b>Amount exceeds limit?</b></span>
              </div>
              <div class="branch-label branch-yes">YES</div><div class="branch-label branch-no">NO</div>
              <div class="flow-node node-action">
                <span class="node-symbol symbol-action">↳</span>
                <span class="node-copy"><small>ACTION</small><b>Request approval</b></span><span class="node-check">✓</span>
              </div>
              <div class="flow-node node-end">
                <span class="node-symbol symbol-end">✓</span>
                <span class="node-copy"><small>COMPLETE</small><b>Continue workflow</b></span>
              </div>
              <div class="canvas-legend"><span><i class="legend-blue"></i> Rule path</span><span><i class="legend-red"></i> Decision point</span></div>
            </div>
          </div>
          <div class="builder-status"><span><i></i> Flow validated</span><span>4 nodes <b>·</b> 2 branches</span></div>
        </div>
        <div class="floating-note note-trace"><span class="trace-icon">↗</span><span><b>Execution trace</b><small>See the path a rule took</small></span></div>
        <div class="floating-note note-reuse"><span class="reuse-icon">▧</span><span><b>Reusable processes</b><small>Build once, use across rules</small></span></div>
      </div>
    </div>
    <div class="hero-bottom container">
      <span>BUSINESS AUTOMATION, WITHOUT THE BLACK BOX</span><span class="hero-bottom-line"></span>
      <span class="hero-bottom-note">A clearer way to build and maintain workflow logic.</span>
    </div>
  </section>

  <section class="intro-strip">
    <div class="container intro-grid">
      <p class="section-kicker">THE CHALLENGE</p>
      <div>
        <h2>Business rules shouldn't be scattered across your codebase.</h2>
        <p>As applications grow, conditions, hooks, scripts, and custom routines can become hard to follow. FlexiRule gives supported business workflows a shared visual model—so teams can understand how the pieces connect and where execution goes next.</p>
      </div>
    </div>
  </section>

  <section class="section section-features" id="features">
    <div class="container">
      <div class="section-heading">
        <p class="section-kicker">A BETTER WAY TO ORCHESTRATE</p>
        <h2>From scattered logic<br /><span class="muted-heading">to a clear execution path.</span></h2>
        <p>Bring the shape of a workflow into view, without pretending every job needs to be no-code.</p>
      </div>
      <div class="feature-grid">
        <article class="feature-card feature-card-large">
          <div class="feature-icon icon-blue"><span>⌘</span></div>
          <p class="feature-label">01 / VISUAL DESIGN</p>
          <h3>Design the flow, not just the code.</h3>
          <p>Compose actions and conditions on a graph where connections make the intended execution order explicit.</p>
          <div class="mini-flow" aria-hidden="true"><span class="mini-flow-node mini-trigger">Trigger</span><i></i><span class="mini-flow-node mini-check">Condition</span><i></i><span class="mini-flow-node mini-action">Action</span></div>
        </article>
        <article class="feature-card">
          <div class="feature-icon icon-red"><span>↗</span></div>
          <p class="feature-label">02 / DECISIONS</p>
          <h3>Make branching understandable.</h3>
          <p>Express conditions and outcome paths in the same model, making decisions easier to review.</p>
        </article>
        <article class="feature-card">
          <div class="feature-icon icon-violet"><span>▧</span></div>
          <p class="feature-label">03 / REUSE</p>
          <h3>Build shared logic once.</h3>
          <p>Use reusable Processes and Operations to reduce duplicated routines across business rules.</p>
        </article>
        <article class="feature-card feature-card-wide">
          <div class="feature-icon icon-dark"><span>⌁</span></div>
          <div>
            <p class="feature-label">04 / OBSERVABILITY</p>
            <h3>See what happened, not just that it failed.</h3>
            <p>Execution tracing and state snapshots help developers inspect a rule's path and investigate unexpected outcomes.</p>
          </div>
          <div class="trace-preview" aria-hidden="true">
            <div class="trace-row"><span class="trace-num">01</span><span class="trace-ok">✓</span><span>Invoice submitted</span><small>12 ms</small></div>
            <div class="trace-row"><span class="trace-num">02</span><span class="trace-ok">✓</span><span>Evaluate conditions</span><small>4 ms</small></div>
            <div class="trace-row trace-row-active"><span class="trace-num">03</span><span class="trace-live">●</span><span>Request approval</span><small>Running</small></div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="section section-process" id="how-it-works">
    <div class="container process-grid">
      <div class="process-copy">
        <p class="section-kicker">HOW IT WORKS</p>
        <h2>A visual model.<br /><span class="muted-heading">A governed runtime.</span></h2>
        <p>FlexiRule complements the Frappe framework: triggers identify when a rule can run, conditions help determine eligibility, and the execution graph coordinates actions and reusable Processes.</p>
        <a class="text-link" href="https://github.com/Sendipad/flexirule">Explore the source code <span aria-hidden="true">↗</span></a>
      </div>
      <div class="process-steps">
        <article class="process-step"><span class="step-number">01</span><div><h3>Connect a trigger</h3><p>Bind a rule to supported document events, scheduled execution, or a callable entry point.</p></div><span class="step-symbol">⌁</span></article>
        <article class="process-step"><span class="step-number">02</span><div><h3>Compose the workflow</h3><p>Configure conditions, action nodes, value mappings, and explicit branches.</p></div><span class="step-symbol">◇</span></article>
        <article class="process-step"><span class="step-number">03</span><div><h3>Trace and improve</h3><p>Use simulation and execution traces to understand behavior and evolve the rule.</p></div><span class="step-symbol">↗</span></article>
      </div>
    </div>
  </section>

  <section class="section section-fit">
    <div class="container fit-panel">
      <div>
        <p class="section-kicker">BUILT FOR THE FRAPPE ECOSYSTEM</p>
        <h2>Keep the framework.<br /><span class="muted-heading">Make workflows clearer.</span></h2>
        <p>FlexiRule is an app for Frappe Framework and ERPNext. It complements normal application code, hooks, and framework extension points instead of claiming to replace them all.</p>
      </div>
      <div class="fit-points">
        <div><span>✓</span><p><b>Declarative where it helps</b><small>Model branching business processes visually.</small></p></div>
        <div><span>✓</span><p><b>Python where it belongs</b><small>Keep custom code available for specialized work.</small></p></div>
        <div><span>✓</span><p><b>Built for maintainers</b><small>Improve review, reuse, and runtime visibility.</small></p></div>
      </div>
    </div>
  </section>

  <section class="section section-comparisons">
    <div class="container">
      <div class="section-heading section-heading-row">
        <div><p class="section-kicker">MAKE AN INFORMED CHOICE</p><h2>Know where FlexiRule fits.</h2></div>
        <a class="text-link" href="/comparisons/">All comparisons <span aria-hidden="true">→</span></a>
      </div>
      <div class="comparison-grid">
        {comparisons.map((comparison) => (
          <ComparisonCard slug={comparison.slug} eyebrow={comparison.eyebrow} title={comparison.title} description={comparison.description} />
        ))}
      </div>
    </div>
  </section>

  <section class="final-cta">
    <div class="container cta-inner">
      <div><p class="section-kicker">START EXPLORING</p><h2>Make your next workflow<br />easier to understand.</h2><p>Explore the code, install FlexiRule, and see whether visual orchestration fits your use case.</p></div>
      <div class="cta-actions"><a class="button button-light" href="https://github.com/Sendipad/flexirule#installation">Get started on GitHub <span aria-hidden="true">↗</span></a><a class="cta-secondary" href="https://github.com/Sendipad/flexirule-docs">Read the documentation <span aria-hidden="true">→</span></a></div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "FlexiRule",
    "applicationCategory": "BusinessApplication",
    "operatingSystem": "Web",
    "description": description,
    "url": "https://flexirule.github.io/",
    "softwareRequirements": "Frappe Framework v15+",
    "codeRepository": "https://github.com/Sendipad/flexirule"
  })} />
</BaseLayout>
