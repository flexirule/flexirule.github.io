---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { comparisons } from "../../data/comparisons";

export function getStaticPaths() {
  return comparisons.map((comparison) => ({
    params: { slug: comparison.slug },
    props: { comparison },
  }));
}

const { comparison } = Astro.props;
---

<BaseLayout title={comparison.title} description={comparison.description}>
  <article class="comparison-article">
    <header class="comparison-hero">
      <div class="container comparison-hero-inner">
        <div class="breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/comparisons/">Comparisons</a><span aria-hidden="true">/</span><span>{comparison.title}</span></div>
        <p class="section-kicker">{comparison.eyebrow}</p>
        <h1>{comparison.headline}</h1>
        <p class="comparison-intro">{comparison.introduction}</p>
        <a class="button button-primary" href="https://github.com/Sendipad/flexirule#installation">Explore FlexiRule <span aria-hidden="true">↗</span></a>
      </div>
    </header>
    <div class="container comparison-body-grid">
      <aside class="comparison-aside">
        <span class="aside-label">IN THIS ARTICLE</span>
        <nav aria-label="In this article">
          {comparison.sections.map((section, index) => <a href={`#section-${index + 1}`}>{section.heading}</a>)}
          <a href="#takeaway">Key takeaway</a>
        </nav>
        <div class="aside-note"><span>i</span><p>Evaluate the trade-offs against your own application, performance needs, and team workflow.</p></div>
      </aside>
      <div class="comparison-content">
        {comparison.sections.map((section, index) => (
          <section class="article-section" id={`section-${index + 1}`}>
            <p class="article-index">0{index + 1} / PERSPECTIVE</p>
            <h2>{section.heading}</h2>
            {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            {section.bullets && (
              <ul class="comparison-bullets">
                {section.bullets.map((item) => <li><span aria-hidden="true">✓</span>{item}</li>)}
              </ul>
            )}
          </section>
        ))}
        <section class="takeaway-panel" id="takeaway">
          <p class="section-kicker">KEY TAKEAWAY</p>
          <p>{comparison.takeaway}</p>
          <a class="text-link" href="https://github.com/Sendipad/flexirule">Explore FlexiRule on GitHub <span aria-hidden="true">↗</span></a>
        </section>
        <div class="article-footer-link"><a href="/comparisons/">← Back to all comparisons</a></div>
      </div>
    </div>
  </article>
</BaseLayout>
