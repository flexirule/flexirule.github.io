---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-top">
    <div class="footer-brand">
      <a class="brand" href="/">
        <img src="/flexirule-mark.svg" alt="" width="38" height="38" loading="lazy" />
        <span class="brand-word">Flexi<span>Rule</span></span>
      </a>
      <p>Make business logic visible. Build, understand, and evolve automation for Frappe and ERPNext.</p>
    </div>
    <div class="footer-column">
      <h2>Explore</h2>
      <a href="/#features">Features</a>
      <a href="/#how-it-works">How it works</a>
      <a href="/comparisons/">Comparisons</a>
    </div>
    <div class="footer-column">
      <h2>Resources</h2>
      <a href="https://github.com/Sendipad/flexirule">Source code <span aria-hidden="true">↗</span></a>
      <a href="https://github.com/Sendipad/flexirule-docs">Documentation <span aria-hidden="true">↗</span></a>
      <a href="https://github.com/Sendipad/flexirule/issues">Report an issue <span aria-hidden="true">↗</span></a>
    </div>
  </div>
  <div class="container footer-bottom">
    <span>© {year} FlexiRule contributors.</span>
    <span>Built for the Frappe ecosystem.</span>
  </div>
</footer>
