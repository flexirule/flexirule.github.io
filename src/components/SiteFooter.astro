---
const year = new Date().getFullYear();

const footerGroups = [
  {
    title: "Explore",
    links: [
      { label: "Features", href: "/#features", external: false },
      { label: "How it works", href: "/#how-it-works", external: false },
      { label: "Comparisons", href: "/comparisons/", external: false },
    ],
  },
  {
    title: "Product",
    links: [
      { label: "Business workflows", href: "/solutions/business-workflows/", external: false },
      { label: "Developer experience", href: "/solutions/developer-experience/", external: false },
      { label: "Architecture choices", href: "/solutions/architecture-choices/", external: false },
    ],
  },
  {
    title: "Resources",
    links: [
      { label: "Documentation", href: "https://github.com/Sendipad/flexirule-docs", external: true },
      { label: "Source code", href: "https://github.com/Sendipad/flexirule", external: true },
      { label: "Report an issue", href: "https://github.com/Sendipad/flexirule/issues", external: true },
    ],
  },
  {
    title: "Community",
    links: [
      { label: "GitHub repository", href: "https://github.com/Sendipad/flexirule", external: true },
      { label: "Open issues", href: "https://github.com/Sendipad/flexirule/issues", external: true },
      { label: "Contributing", href: "https://github.com/Sendipad/flexirule/blob/develop/CONTRIBUTING.md", external: true },
    ],
  },
];
---

<footer class="site-footer">
  <div class="container footer-top">
    <div class="footer-brand">
      <a class="brand" href="/">
        <img src="/flexirule-mark.svg" alt="" width="38" height="38" loading="lazy" />
        <span class="brand-word">Flexi<span>Rule</span></span>
      </a>
      <p>Make business logic visible. Build, understand, and evolve automation for Frappe and ERPNext.</p>
    </div>
    {footerGroups.map((group) => (
      <nav class="footer-column" aria-label={group.title}>
        <h2>{group.title}</h2>
        {group.links.map((link) => (
          <a
            href={link.href}
            {...(link.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
          >
            {link.label}
            {link.external && <span aria-hidden="true"> ↗</span>}
          </a>
        ))}
      </nav>
    ))}
  </div>
  <div class="container footer-bottom">
    <span>© {year} FlexiRule contributors.</span>
    <span>Built for the Frappe ecosystem.</span>
  </div>
</footer>
