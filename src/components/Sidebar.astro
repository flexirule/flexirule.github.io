---
interface NavItem {
  label: string;
  href: string;
  external?: boolean;
  desc?: string;
}

interface NavGroup {
  title: string;
  icon: string;
  items: NavItem[];
}

const pathname = Astro.url.pathname;

const navGroups: NavGroup[] = [
  {
    title: "Product",
    icon: `<path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" />`,
    items: [
      { label: "Features", href: "/#features", desc: "Visual rule building and tracing" },
      { label: "How It Works", href: "/#how-it-works", desc: "Triggers, conditions, and actions" },
      { label: "Built for Frappe", href: "/#built-for-frappe", desc: "Designed for Frappe & ERPNext" },
    ],
  },
  {
    title: "Solutions",
    icon: `<path d="M22 12h-4l-3 9L9 3l-3 9H2" />`,
    items: [
      { label: "Business Workflows", href: "/#features", desc: "Readable condition and action logic" },
      { label: "Developer Experience", href: "/#how-it-works", desc: "Visual orchestration alongside code" },
      { label: "Architecture Choices", href: "/comparisons/", desc: "Evaluate against native approaches" },
    ],
  },
  {
    title: "Comparisons",
    icon: `<path d="M16 3h5v5M4 20L21 3M21 16v5h-5M15 15l6 6M4 4l5 5" />`,
    items: [
      { label: "Overview", href: "/comparisons/" },
      { label: "vs Server Scripts", href: "/comparisons/flexirule-vs-server-scripts/" },
      { label: "vs Custom Hooks", href: "/comparisons/flexirule-vs-custom-hooks/" },
    ],
  },
  {
    title: "Resources",
    icon: `<path d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />`,
    items: [
      { label: "Documentation", href: "https://github.com/Sendipad/flexirule-docs", external: true },
      { label: "Source Code", href: "https://github.com/Sendipad/flexirule", external: true },
      { label: "Community & Support", href: "https://github.com/Sendipad/flexirule/issues", external: true },
    ],
  },
];
---

<aside class="site-sidebar" data-site-sidebar>
  <div class="sidebar-inner">
    <div class="sidebar-brand-row">
      <a class="sidebar-brand" href="/" aria-label="FlexiRule home">
        <img src="/flexirule-mark.svg" alt="" width="32" height="32" class="sidebar-logo" />
        <span class="brand-text">Flexi<span class="brand-accent">Rule</span></span>
      </a>

      <button
        class="sidebar-pin-btn desktop-only"
        type="button"
        data-sidebar-pin
        aria-label="Toggle sidebar collapse"
        title="Toggle sidebar collapse"
      >
        <svg class="pin-icon-unpinned" viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none"><path d="M12 17v5M9 2h6l-1 5 4 4v2H6v-2l4-4-1-5z" /></svg>
        <svg class="pin-icon-pinned" viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="currentColor"><path d="M12 17v5M9 2h6l-1 5 4 4v2H6v-2l4-4-1-5z" /></svg>
      </button>

      <button
        class="sidebar-close-btn mobile-only"
        type="button"
        data-sidebar-close
        aria-label="Close menu"
      >
        <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none"><path d="M18 6L6 18M6 6l12 12" /></svg>
      </button>
    </div>

    <nav class="sidebar-nav" aria-label="Main Navigation">
      <ul class="nav-group-list">
        {navGroups.map((group, groupIdx) => {
          const isGroupActive = group.items.some(
            (item) => !item.external && (pathname === item.href || (item.href !== "/" && item.href !== "/#features" && item.href !== "/#how-it-works" && item.href !== "/#built-for-frappe" && pathname.startsWith(item.href)))
          );

          return (
            <li class="nav-group-item">
              <details class="nav-group-details" open={isGroupActive}>
                <summary class="nav-group-summary">
                  <span class="group-icon-wrap" title={group.title}>
                    <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" set:html={group.icon} />
                  </span>
                  <span class="group-title">{group.title}</span>
                  <svg class="group-arrow" viewBox="0 0 16 16" width="12" height="12" fill="currentColor"><path d="m4 6 4 4 4-4" /></svg>
                </summary>

                <ul class="sub-nav-list">
                  {group.items.map((item) => {
                    const isActive = !item.external && (
                      pathname === item.href || (item.href.length > 1 && !item.href.includes("#") && pathname.startsWith(item.href))
                    );

                    return (
                      <li>
                        <a
                          class:list={["sub-nav-link", { "is-active": isActive }]}
                          href={item.href}
                          target={item.external ? "_blank" : undefined}
                          rel={item.external ? "noreferrer" : undefined}
                          aria-current={isActive ? "page" : undefined}
                        >
                          <span class="nav-item-label">{item.label}</span>
                          {item.external && <span class="external-icon" aria-hidden="true">↗</span>}
                        </a>
                      </li>
                    );
                  })}
                </ul>
              </details>
            </li>
          );
        })}
      </ul>
    </nav>

    <div class="sidebar-footer">
      <div class="sidebar-note">
        <strong>Frappe &amp; ERPNext</strong>
        <p>Visual Business Automation Engine</p>
      </div>
    </div>
  </div>
</aside>

<script>
  const sidebar = document.querySelector<HTMLElement>("[data-site-sidebar]");
  const backdrop = document.querySelector<HTMLButtonElement>("[data-mobile-backdrop]");
  const closeBtn = document.querySelector<HTMLButtonElement>("[data-sidebar-close]");
  const pinBtn = document.querySelector<HTMLButtonElement>("[data-sidebar-pin]");

  // Restore expanded state on desktop if previously expanded
  try {
    const isExpanded = localStorage.getItem("flexirule-sidebar-expanded") === "true";
    if (isExpanded && sidebar) {
      sidebar.classList.add("is-expanded");
      document.documentElement.classList.add("sidebar-expanded-layout");
    }
  } catch {}

  const toggleDesktopSidebar = () => {
    if (!sidebar) return;
    const expanded = sidebar.classList.toggle("is-expanded");
    document.documentElement.classList.toggle("sidebar-expanded-layout", expanded);
    try {
      localStorage.setItem("flexirule-sidebar-expanded", String(expanded));
    } catch {}
  };

  pinBtn?.addEventListener("click", toggleDesktopSidebar);

  const closeMobileSidebar = () => {
    document.body.classList.remove("mobile-sidebar-open");
    document.documentElement.classList.remove("mobile-sidebar-open");
  };

  backdrop?.addEventListener("click", closeMobileSidebar);
  closeBtn?.addEventListener("click", closeMobileSidebar);

  sidebar?.querySelectorAll<HTMLAnchorElement>("a").forEach((link) => {
    link.addEventListener("click", () => {
      closeMobileSidebar();
    });
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      closeMobileSidebar();
    }
  });
</script>
