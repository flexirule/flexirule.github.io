---
interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  breadcrumbs?: BreadcrumbItem[];
}

const { breadcrumbs = [] } = Astro.props;
const pathname = Astro.url.pathname;

let displayBreadcrumbs: BreadcrumbItem[] = [];

if (breadcrumbs.length > 0) {
  displayBreadcrumbs = [
    { label: "FlexiRule", href: pathname === "/" ? undefined : "/" },
    ...breadcrumbs.filter((b) => b.label.toLowerCase() !== "home" && b.label.toLowerCase() !== "flexirule"),
  ];
} else if (pathname === "/") {
  displayBreadcrumbs = [{ label: "FlexiRule" }];
} else if (pathname.startsWith("/comparisons/")) {
  const parts = pathname.split("/").filter(Boolean);
  if (parts.length === 1) {
    displayBreadcrumbs = [
      { label: "FlexiRule", href: "/" },
      { label: "Comparisons" },
    ];
  } else {
    displayBreadcrumbs = [
      { label: "FlexiRule", href: "/" },
      { label: "Comparisons", href: "/comparisons/" },
      { label: parts[1].replace(/-/g, " ").replace(/\b\w/g, (l) => l.toUpperCase()) },
    ];
  }
} else {
  const pageName = pathname.replace(/\//g, "").replace(/-/g, " ");
  const formattedName = pageName.charAt(0).toUpperCase() + pageName.slice(1);
  displayBreadcrumbs = [
    { label: "FlexiRule", href: "/" },
    { label: formattedName || "Page" },
  ];
}
---

<header class="top-header" data-top-header>
  <div class="top-header-left">
    <button
      class="sidebar-toggle-btn mobile-only"
      type="button"
      data-mobile-sidebar-toggle
      aria-label="Toggle Navigation Drawer"
      title="Toggle Navigation Drawer"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h16M4 12h16M4 17h16" /></svg>
    </button>

    <button
      class="sidebar-toggle-btn desktop-only"
      type="button"
      data-desktop-sidebar-toggle
      aria-label="Collapse Sidebar"
      title="Toggle Sidebar"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h16M4 12h16M4 17h16" /></svg>
    </button>

    <nav aria-label="Breadcrumb" class="header-breadcrumbs">
      <ol class="breadcrumb-list">
        {displayBreadcrumbs.map((item, index) => {
          const isLast = index === displayBreadcrumbs.length - 1;
          return (
            <li class="breadcrumb-item">
              {index > 0 && <span class="breadcrumb-separator" aria-hidden="true">›</span>}
              {!isLast && item.href ? (
                <a href={item.href} class="breadcrumb-link">{item.label}</a>
              ) : (
                <span class:list={["breadcrumb-current", { "root-only": displayBreadcrumbs.length === 1 }]} aria-current={isLast ? "page" : undefined}>{item.label}</span>
              )}
            </li>
          );
        })}
      </ol>
    </nav>
  </div>

  <div class="top-header-right">
    <button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch theme" title="Switch theme">
      <svg data-theme-icon viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"/></svg>
      <span class="theme-toggle-label" data-theme-label>Theme</span>
    </button>
    <a class="nav-github desktop-only" href="https://github.com/Sendipad/flexirule" target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a>
    <a class="button button-primary header-cta" href="https://github.com/Sendipad/flexirule#installation">Get started <span aria-hidden="true">↗</span></a>
  </div>
</header>

<script>
  const mobileToggle = document.querySelector<HTMLButtonElement>("[data-mobile-sidebar-toggle]");
  const desktopToggle = document.querySelector<HTMLButtonElement>("[data-desktop-sidebar-toggle]");
  const body = document.body;
  const doc = document.documentElement;

  mobileToggle?.addEventListener("click", () => {
    body.classList.toggle("mobile-sidebar-open");
  });

  desktopToggle?.addEventListener("click", () => {
    const isCollapsed = doc.classList.toggle("sidebar-collapsed");
    try {
      localStorage.setItem("flexirule-sidebar-collapsed", String(isCollapsed));
    } catch {}
  });

  const themeButton = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
  const themeLabel = document.querySelector<HTMLElement>("[data-theme-label]");
  const themeIcon = document.querySelector<SVGElement>("[data-theme-icon]");
  const themePreference = window.matchMedia("(prefers-color-scheme: dark)");

  const readSavedTheme = (): "light" | "dark" | null => {
    try {
      const value = window.localStorage.getItem("flexirule-theme");
      return value === "light" || value === "dark" ? value : null;
    } catch {
      return null;
    }
  };

  const saveTheme = (theme: "light" | "dark") => {
    try {
      window.localStorage.setItem("flexirule-theme", theme);
    } catch {}
  };

  const applyTheme = (theme: "light" | "dark") => {
    document.documentElement.dataset.theme = theme;
    document.querySelector('meta[name="theme-color"]')?.setAttribute("content", theme === "dark" ? "#111111" : "#ffffff");
    const nextTheme = theme === "dark" ? "light" : "dark";
    themeButton?.setAttribute("aria-label", `Switch to ${nextTheme} theme`);
    themeButton?.setAttribute("title", `Switch to ${nextTheme} theme`);
    if (themeLabel) themeLabel.textContent = theme === "dark" ? "Dark" : "Light";
    if (themeIcon) {
      themeIcon.innerHTML = theme === "dark"
        ? '<path d="M20.9 13A9 9 0 0 1 11 3.1 9 9 0 1 0 20.9 13Z"/>'
        : '<circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"/>';
    }
  };

  applyTheme(readSavedTheme() ?? (themePreference.matches ? "dark" : "light"));

  themeButton?.addEventListener("click", () => {
    const nextTheme = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
    saveTheme(nextTheme);
    applyTheme(nextTheme);
  });

  themePreference.addEventListener("change", (event) => {
    if (!readSavedTheme()) applyTheme(event.matches ? "dark" : "light");
  });
</script>
