---
import TopHeader from "../components/TopHeader.astro";
import Sidebar from "../components/Sidebar.astro";
import SiteFooter from "../components/SiteFooter.astro";
import "../styles/global.css";
import "../styles/theme.css";

interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  noindex?: boolean;
  breadcrumbs?: BreadcrumbItem[];
}

const {
  title,
  description,
  ogImage = "/og/flexirule-social.svg",
  noindex = false,
  breadcrumbs = [],
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();
const socialImageUrl = new URL(ogImage, Astro.site ?? Astro.url).toString();
const pageTitle = title.includes("FlexiRule") ? title : `${title} | FlexiRule`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#ffffff" />
    <script is:inline>
      try {
        const savedTheme = localStorage.getItem("flexirule-theme");
        const initialTheme = savedTheme === "light" || savedTheme === "dark"
          ? savedTheme
          : window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        document.documentElement.dataset.theme = initialTheme;
        document.querySelector('meta[name="theme-color"]')?.setAttribute("content", initialTheme === "dark" ? "#111111" : "#ffffff");

        const savedSidebarState = localStorage.getItem("flexirule-sidebar-collapsed");
        if (savedSidebarState === "true") {
          document.documentElement.classList.add("sidebar-collapsed");
        }
      } catch {
        document.documentElement.dataset.theme = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
      }
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="FlexiRule contributors" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400..800&display=swap" rel="stylesheet" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/flexirule-mark.svg" />
    <link rel="apple-touch-icon" href="/flexirule-mark.svg" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="FlexiRule" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="site-app-shell">
      <Sidebar />
      <div class="site-main-layout">
        <TopHeader breadcrumbs={breadcrumbs} />
        <main id="main-content" class="site-content">
          <slot />
        </main>
        <SiteFooter />
      </div>
    </div>
  </body>
</html>
